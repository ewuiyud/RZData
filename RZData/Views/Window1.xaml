<Window x:Class="BIMTools.Views.MaterialListManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM材料清单汇总管理" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 样式定义 -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#81A1C1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E9F0"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style x:Key="MappingPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#D08770"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#434C5E" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="BIM材料清单汇总管理系统" 
                          FontSize="20" FontWeight="Bold" Foreground="White" 
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="连接Revit模型" Style="{StaticResource ActionButtonStyle}"
                            Background="#A3BE8C" Name="ConnectRevitBtn"/>
                    <Button Content="导入数据" Style="{StaticResource ActionButtonStyle}"
                            Name="ImportDataBtn"/>
                    <Button Content="导出报告" Style="{StaticResource ActionButtonStyle}"
                            Name="ExportReportBtn"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主要内容区域 -->
        <TabControl Grid.Row="1" Margin="10">

            <!-- 模型工程量清单 -->
            <TabItem Header="模型工程量清单" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="模型连接状态：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Ellipse Width="12" Height="12" Fill="#BF616A" Name="ConnectionStatus"/>
                                <TextBlock Text="未连接" Margin="5,0" Name="ConnectionStatusText"/>
                                <TextBlock Text="| 构件总数：" Margin="20,0,5,0"/>
                                <TextBlock Text="0" Name="TotalComponentsText" FontWeight="Bold"/>
                                <TextBlock Text="| 已映射：" Margin="10,0,5,0"/>
                                <TextBlock Text="0" Name="MappedComponentsText" FontWeight="Bold" Foreground="#A3BE8C"/>
                                <TextBlock Text="| 未映射：" Margin="10,0,5,0"/>
                                <TextBlock Text="0" Name="UnmappedComponentsText" FontWeight="Bold" Foreground="#BF616A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="刷新模型数据" Style="{StaticResource ActionButtonStyle}" Name="RefreshModelBtn"/>
                                <Button Content="配置映射规则" Style="{StaticResource ActionButtonStyle}" Name="ConfigMappingBtn"/>
                                <Button Content="自动映射" Style="{StaticResource ActionButtonStyle}" 
                                        Background="#A3BE8C" Name="AutoMappingBtn"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 模型工程量清单表格 -->
                    <DataGrid Grid.Row="1" Name="ModelQuantityGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="构件ID" Binding="{Binding ComponentId}" Width="100"/>
                            <DataGridTextColumn Header="构件名称" Binding="{Binding ComponentName}" Width="150"/>
                            <DataGridTextColumn Header="构件类型" Binding="{Binding ComponentType}" Width="120"/>
                            <DataGridTextColumn Header="详细参数" Binding="{Binding DetailedParameters}" Width="200"/>
                            <DataGridTextColumn Header="规格型号" Binding="{Binding Specification}" Width="120"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="体积(m³)" Binding="{Binding Volume}" Width="80"/>
                            <DataGridTextColumn Header="重量(kg)" Binding="{Binding Weight}" Width="80"/>
                            <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="100"/>
                            <DataGridTextColumn Header="映射状态" Binding="{Binding MappingStatus}" Width="100"/>
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="查看" Padding="5,2" Margin="2" FontSize="10"/>
                                            <Button Content="映射" Padding="5,2" Margin="2" FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 映射规则和未映射项目 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 映射规则面板 -->
                        <Border Grid.Column="0" Style="{StaticResource MappingPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="映射规则" Style="{StaticResource HeaderTextStyle}"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="MappingRulesPanel">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" 
                                                       CornerRadius="3" Margin="2" Padding="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="{Binding RuleName}" 
                                                                  FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding RuleDescription}" 
                                                                  FontSize="10" Foreground="#666" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 未映射项目面板 -->
                        <Border Grid.Column="1" Style="{StaticResource MappingPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="未映射项目" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="(需要手动处理)" FontSize="12" Foreground="#BF616A" 
                                              VerticalAlignment="Center" Margin="5,0"/>
                                </StackPanel>

                                <ListBox Grid.Row="1" Name="UnmappedItemsList" 
                                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="#BF616A" BorderThickness="1" 
                                                   CornerRadius="3" Margin="2" Padding="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ComponentName}" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="{Binding ComponentType}" FontSize="10" Foreground="#666"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="映射" Padding="4,2" FontSize="10"
                                                           Background="#D08770" Foreground="White" BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 工程量清单 -->
            <TabItem Header="工程量清单" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="基于模型工程量清单生成 | 清单项目数：" VerticalAlignment="Center"/>
                                <TextBlock Text="0" Name="QuantityListCountText" FontWeight="Bold" Margin="5,0"/>
                                <TextBlock Text="| 总造价：" Margin="20,0,5,0"/>
                                <TextBlock Text="¥0.00" Name="TotalCostText" FontWeight="Bold" Foreground="#5E81AC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="从模型生成" Style="{StaticResource ActionButtonStyle}" 
                                        Background="#A3BE8C" Name="GenerateFromModelBtn"/>
                                <Button Content="配置定额映射" Style="{StaticResource ActionButtonStyle}" Name="ConfigQuotaBtn"/>
                                <Button Content="导出清单" Style="{StaticResource ActionButtonStyle}" Name="ExportQuantityBtn"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 工程量清单表格 -->
                    <DataGrid Grid.Row="1" Name="QuantityListGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目编码" Binding="{Binding ItemCode}" Width="100"/>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding ItemName}" Width="150"/>
                            <DataGridTextColumn Header="项目特征" Binding="{Binding ItemCharacteristics}" Width="200"/>
                            <DataGridTextColumn Header="计量单位" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="工程量" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="综合单价" Binding="{Binding UnitPrice}" Width="100"/>
                            <DataGridTextColumn Header="合价" Binding="{Binding TotalPrice}" Width="120"/>
                            <DataGridTextColumn Header="定额子目" Binding="{Binding QuotaItems}" Width="150"/>
                            <DataGridTextColumn Header="对应构件" Binding="{Binding RelatedComponents}" Width="120"/>
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑" Padding="5,2" Margin="2" FontSize="10"/>
                                            <Button Content="删除" Padding="5,2" Margin="2" FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 定额映射规则 -->
                    <Border Grid.Row="2" Style="{StaticResource MappingPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="定额映射规则" Style="{StaticResource HeaderTextStyle}"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="QuotaMappingRulesPanel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#5E81AC" BorderThickness="1" 
                                                   CornerRadius="3" Margin="2" Padding="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SourceComponent}" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="{Binding TargetQuota}" FontSize="10" Foreground="#666"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding ConversionFactor}" 
                                                              VerticalAlignment="Center" TextAlignment="Center"/>

                                                    <Button Grid.Column="2" Content="修改" Padding="4,2" FontSize="10"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 采购清单 -->
            <TabItem Header="采购清单" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="基于模型工程量清单生成 | 材料种类：" VerticalAlignment="Center"/>
                                <TextBlock Text="0" Name="MaterialTypesCountText" FontWeight="Bold" Margin="5,0"/>
                                <TextBlock Text="| 采购总额：" Margin="20,0,5,0"/>
                                <TextBlock Text="¥0.00" Name="TotalPurchaseAmountText" FontWeight="Bold" Foreground="#5E81AC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="从模型生成" Style="{StaticResource ActionButtonStyle}" 
                                        Background="#A3BE8C" Name="GeneratePurchaseFromModelBtn"/>
                                <Button Content="配置材料映射" Style="{StaticResource ActionButtonStyle}" Name="ConfigMaterialBtn"/>
                                <Button Content="导出采购单" Style="{StaticResource ActionButtonStyle}" Name="ExportPurchaseBtn"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 采购清单表格 -->
                    <DataGrid Grid.Row="1" Name="PurchaseListGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="材料编码" Binding="{Binding MaterialCode}" Width="100"/>
                            <DataGridTextColumn Header="材料名称" Binding="{Binding MaterialName}" Width="150"/>
                            <DataGridTextColumn Header="规格型号" Binding="{Binding Specification}" Width="150"/>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="需求数量" Binding="{Binding RequiredQuantity}" Width="100"/>
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="80"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="100"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Supplier}" Width="120"/>
                            <DataGridTextColumn Header="预计到货" Binding="{Binding ExpectedDelivery}" Width="100"/>
                            <DataGridTextColumn Header="对应构件" Binding="{Binding RelatedComponents}" Width="120"/>
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑" Padding="5,2" Margin="2" FontSize="10"/>
                                            <Button Content="询价" Padding="5,2" Margin="2" FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 材料映射规则 -->
                    <Border Grid.Row="2" Style="{StaticResource MappingPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="材料映射规则" Style="{StaticResource HeaderTextStyle}"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="MaterialMappingRulesPanel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#EBCB8B" BorderThickness="1" 
                                                   CornerRadius="3" Margin="2" Padding="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SourceComponent}" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="{Binding TargetMaterial}" FontSize="10" Foreground="#666"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding MaterialRatio}" 
                                                              VerticalAlignment="Center" TextAlignment="Center"/>

                                                    <Button Grid.Column="2" Content="修改" Padding="4,2" FontSize="10"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
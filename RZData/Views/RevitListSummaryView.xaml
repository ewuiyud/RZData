                                        </Border>
                                        <ComboBox Width="250" Height="25" Margin="10,2.5" DropDownOpened="ComboBox_DropDownOpened_1" ItemsSource="{Binding PropertyValues}" SelectedItem="{Binding SelectedPropertyValue}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="增加" Background="#A3BE8C" HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddRequiredPropertiesCommand}"/>
                                    <ScrollViewer  Grid.Row="1" Template="{StaticResource MyScrollViewer}" 
                                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="40" Focusable="True">
                                        <ItemsControl d:ItemsSource="{d:SampleData}" ItemsSource="{Binding RequiredProperties}" Grid.Row="3" Margin="0" Height="40" VerticalContentAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate >
                                                <DataTemplate>
                                                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Height="23" CornerRadius="3" VerticalAlignment="Center">

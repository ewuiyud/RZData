                                        <Button Grid.Row="1" Grid.Column="1" Content="清除" Background="#A3BE8C" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteRequiredPropertiesCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>-->

                            <Border Grid.Row="5" 
                        Background="White" CornerRadius="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gray" Direction="320" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- 筛选条件输入 -->
                                    <GroupBox Style="{StaticResource FilterGroupBoxStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 属性选择 -->
                                            <Label Grid.Row="0" Grid.Column="0" Content="属性:" 
                                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1"  ItemsSource="{Binding PropertyNames}"
                                          Style="{StaticResource FilterComboBoxStyle}" Margin="0 0 50 0"
                                          DropDownOpened="FilterProperty_Drop" 
                                          SelectedItem="{Binding SelectedFilterProperty, Mode=TwoWay}"/>

                                            <!-- 值选择 -->
                                            <Label Grid.Row="0" Grid.Column="2" Content="值:" 
                                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                            <ComboBox x:Name="FilterValueComboBox" Grid.Row="0" Grid.Column="3"
                                          Style="{StaticResource FilterComboBoxStyle}" Margin="0 0 50 0"
                                          DropDownOpened="FilterValue_DropDown"  ItemsSource="{Binding PropertyValues}"
                                          IsEnabled="{Binding ElementName=CustomFilterValueText, Path=Text.IsEmpty}"
                                          SelectedItem="{Binding SelectedFilterValue , Mode=TwoWay}"/>

                                            <!-- 添加按钮和清除按钮-->
                                            <Button Grid.Row="0" Grid.Column="4" Content="添加条件" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddFilterConditionCommand}"/>
                                            <Button Content="清除筛选" Grid.Row="0" Grid.Column="5" 
                                                    Style="{StaticResource FilterButtonStyle}" 
                                                    Command="{Binding ClearFilterCommand}"/>

                                            <!--  筛选条件展示 -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="6" BorderThickness="1" BorderBrush="#E0E0E0" Background="White" MinHeight="50" MaxHeight="120" Margin="20 10 0 0">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding FilterConditions}" Margin="5">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource FilterConditionItemStyle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding PropertyName}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                                                            <TextBlock Text="{Binding Logic}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                                                            <TextBlock Text="{Binding PropertyValue}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="×" Width="20" Height="20" FontSize="12" FontWeight="Bold" Background="Transparent"  BorderThickness="0" Foreground="Red"
                                                                                Cursor="Hand"
                                                                                Command="{Binding DataContext.RemoveFilterConditionCommand, 
                                                                            RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" 
                                                                                            CornerRadius="10">
                                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                                          VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="#FFE0E0"/>
                                                                                            <Setter Property="Foreground" Value="#CC0000"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Style="{StaticResource ActionButtonStyle}"  Margin="10 50" Name="ConfigMappingBtn" Click="Button_Click"/>
                                <Button Content="导出报告" Style="{StaticResource ActionButtonStyle}" Margin="10 50"  Command="{Binding ExportExcelCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!--附加表格-->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--构件细项-->
                        <Border Style="{StaticResource MappingPanelStyle}" Background="#fdfdfe">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="构件细项" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ShowAssemblyList}" Style="{StaticResource DataGridStyle}"
                             SelectedItem="{Binding SelectedAssemblyRecord}"
                             MouseDoubleClick="DataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="行号">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Converter={StaticResource RowIndexConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="构件名称" Binding="{Binding AssemblyName}"/>
                                        <!--<DataGridTextColumn Header="所属模型" Binding="{Binding Modelbelonging}"/>-->
                                        <DataGridTextColumn Header="构件ID" Binding="{Binding AssemblyID}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <!--未匹配的项-->
                        <Border Style="{StaticResource MappingPanelStyle}" Background="#fdfdfe" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="未匹配的项目" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="(需要手动处理)" Foreground="Red" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" x:Name="UnmatchedAssemblyDataGrid" ItemsSource="{Binding UnmatchedAssemblyList}" Style="{StaticResource DataGridStyle}" SelectedItem="{Binding SelectedUnMatchedAssemblyRecord}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="行号">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Converter={StaticResource RowIndexConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="构件名称" Binding="{Binding AssemblyName}"/>
                                        <!--<DataGridTextColumn Header="所属模型" Binding="{Binding Modelbelonging}"/>-->
                                        <DataGridTextColumn Header="构件ID" Binding="{Binding AssemblyID}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="工程量清单">
                <DataGrid Grid.Row="0" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ShowMaterialList}"  EnableRowVirtualization="False"
                  SelectedItem="{Binding SelectedMaterialRecord}" SelectionChanged="DataGrid_SelectionChanged" Margin="5 5 5 0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="行号" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Converter={StaticResource RowIndexConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="材料名称" Binding="{Binding MaterialName}" Width="100"/>
                        <DataGridTextColumn Header="使用方式"  Binding="{Binding UsageMethod}" Width="100"/>
                        <DataGridTemplateColumn Header="项目特征" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding ProductMaterialLibrary.Description}" 
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NotNullStringVisble}}"/>
                                        <TextBlock Text="{Binding ProjectFeatures}"
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NullStringVisble}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="模型工程量"  Binding="{Binding ModelEngineeringQuantity}" Width="100"/>
                        <DataGridTextColumn Header="模型工程量单位"  Binding="{Binding ModelEngineeringUnit}" Width="100"/>
                        <DataGridTextColumn Header="关联物料库"  Binding="{Binding ProductMaterialLibrary.Name}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量"  Binding="{Binding MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量单位"  Binding="{Binding MaterialUnit}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量"  Binding="{Binding MaterialProcurementQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量单位"  Binding="{Binding ProcurementUnit}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="采购工程量清单">
                <DataGrid Grid.Row="0" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ShowMaterialList}"  EnableRowVirtualization="False"
                  SelectedItem="{Binding SelectedMaterialRecord}" SelectionChanged="DataGrid_SelectionChanged" Margin="5 5 5 0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="行号" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Converter={StaticResource RowIndexConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="材料名称" Binding="{Binding MaterialName}" Width="100"/>
                        <DataGridTextColumn Header="使用方式"  Binding="{Binding UsageMethod}" Width="100"/>
                        <DataGridTemplateColumn Header="项目特征" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding ProductMaterialLibrary.Description}" 
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NotNullStringVisble}}"/>
                                        <TextBlock Text="{Binding ProjectFeatures}"
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NullStringVisble}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="模型工程量"  Binding="{Binding ModelEngineeringQuantity}" Width="100"/>
                        <DataGridTextColumn Header="模型工程量单位"  Binding="{Binding ModelEngineeringUnit}" Width="100"/>
                        <DataGridTextColumn Header="关联物料库"  Binding="{Binding ProductMaterialLibrary.Name}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量"  Binding="{Binding MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料工程量单位"  Binding="{Binding MaterialUnit}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量"  Binding="{Binding MaterialProcurementQuantity}" Width="100"/>
                        <DataGridTextColumn Header="材料采购量单位"  Binding="{Binding ProcurementUnit}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

<Window x:Class="RZData.Views.RevitListSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RZData.Views"
             xmlns:convert="clr-namespace:RZData.Converters"
             mc:Ignorable="d" 
             Title="清单计算"
             MaxHeight="900" MinHeight="900" MaxWidth="1400" MinWidth="1400">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RZData;component/Styles/Style.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <convert:StringNullToVisble x:Key="NullStringVisble"/>
            <convert:StringNotNullToVisibleConverter x:Key="NotNullStringVisble"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <convert:RowIndexConverter x:Key="RowIndexConverter"/>
            <Style x:Key="TabItemStyle" TargetType="TabItem">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="Margin" Value="2,0"/>
            </Style>
            <Style x:Key="DataGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5E9F0"/>
                <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Single"/>
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="#5E81AC"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#81A1C1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MappingPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="#ECEFF4"/>
                <Setter Property="BorderBrush" Value="#D08770"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Foreground" Value="#2E3440"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题栏 -->
        <Border Background="#434C5E" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="材料清单汇总管理系统" 
                          FontSize="20" FontWeight="Bold" Foreground="White" 
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource ActionButtonStyle}"
                            Background="#A3BE8C" Name="ConnectRevitBtn" Visibility="Hidden"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 主要内容区域 -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- 模型工程量清单 -->
            <TabItem Header="模型工程量清单" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    <!-- 模型工程量清单表格 -->
                    <DataGrid Grid.Row="0" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ShowMaterialList}"  EnableRowVirtualization="False"
                  SelectedItem="{Binding SelectedMaterialRecord}" SelectionChanged="DataGrid_SelectionChanged" Margin="5 5 5 0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="行号" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Converter={StaticResource RowIndexConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="材料名称" Binding="{Binding MaterialName}" Width="100"/>
                            <DataGridTextColumn Header="使用方式"  Binding="{Binding UsageMethod}" Width="100"/>
                            <DataGridTemplateColumn Header="项目特征" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding ProductMaterialLibrary.Description}" 
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NotNullStringVisble}}"/>
                                            <TextBlock Text="{Binding ProjectFeatures}"
                                                           Visibility="{Binding ProductMaterialLibrary.Description,Converter={StaticResource NullStringVisble}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="模型工程量"  Binding="{Binding ModelEngineeringQuantity}" Width="100"/>
                            <DataGridTextColumn Header="模型工程量单位"  Binding="{Binding ModelEngineeringUnit}" Width="100"/>
                            <DataGridTextColumn Header="关联物料库"  Binding="{Binding ProductMaterialLibrary.Name}" Width="100"/>
                            <DataGridTextColumn Header="材料工程量"  Binding="{Binding MaterialQuantity}" Width="100"/>
                            <DataGridTextColumn Header="材料工程量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                            <DataGridTextColumn Header="材料工程量单位"  Binding="{Binding MaterialUnit}" Width="100"/>
                            <DataGridTextColumn Header="材料采购量(有库)"  Binding="{Binding ProductMaterialLibrary.MaterialQuantity}" Width="100"/>
                            <DataGridTextColumn Header="材料采购量"  Binding="{Binding MaterialProcurementQuantity}" Width="100"/>
                            <DataGridTextColumn Header="材料采购量单位"  Binding="{Binding ProcurementUnit}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 操作栏 -->
                    <Border Grid.Row="1" Background="#F8F9FA"  Margin="5 5 5 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!--筛选-->
                            <!--<Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Background="#ffffff" Margin="0">
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="* "/>
                                        <RowDefinition Height="* "/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Height="40" HorizontalAlignment="Stretch">
                                        <Border BorderBrush="Gray" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0">
